{
    "name": "packstub/agents",
    "description": "AI agents for Laravel: an agent engine and an MCP server sharing one tool list, built on laravel/ai and laravel/mcp — tools gated by the app's own abilities, read or write tokens for Claude Code, Claude Desktop and Cursor, queued turns, budgets and limits per workspace and per user. packstub/filament-agents adds the chat and the operator pages to a Filament panel.",
    "keywords": [
        "laravel",
        "ai",
        "agents",
        "assistant",
        "mcp",
        "mcp-server",
        "laravel-ai",
        "laravel-mcp",
        "chat"
    ],
    "type": "library",
    "license": "MIT",
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/icaliman"
        }
    ],
    "authors": [
        {
            "name": "Packstub",
            "email": "support@packstub.dev",
            "homepage": "https://packstub.dev"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/ai": "^0.11",
        "laravel/framework": "^13.0",
        "laravel/mcp": "^0.9",
        "laravel/sanctum": "^4.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "orchestra/testbench": "^11.2",
        "phpunit/phpunit": "^13.3",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "orchestra/pest-plugin-testbench": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Packstub\\Agents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Packstub\\Agents\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:filter": "pest --filter",
        "lint": "vendor/bin/pint",
        "lint:test": "vendor/bin/pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Packstub\\Agents\\AgentsServiceProvider"
            ],
            "aliases": {
                "Agents": "Packstub\\Agents\\Facades\\Agents"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "homepage": "https://github.com/packstub/agents",
    "support": {
        "issues": "https://github.com/packstub/agents/issues",
        "source": "https://github.com/packstub/agents",
        "docs": "https://packstub.dev/docs/agents"
    },
    "suggest": {
        "packstub/filament-agents": "The in-panel chat, the Agent access page (MCP tokens), the operator's limits and turns pages, and live resource tables in answers, for a Filament v5 panel.",
        "packstub/filament-tenancy": "Database-per-tenant panels: the MCP endpoint and the turns follow the workspace automatically."
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
